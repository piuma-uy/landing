{
  "name": "piuma-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --define \"PIUMA_SITE_ENV='${SITE_ENV:-prod}'\" && node --import ./tests/resolve-ts.ts scripts/prerender.ts",
    "watch": "ng build --watch --configuration development",
    "test": "tsc -p tsconfig.spec.json && node --import ./tests/resolve-ts.ts --test tests/*.test.ts"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "libphonenumber-js": "^1.13.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/node": "^26.1.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
